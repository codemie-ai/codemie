# =============================================================================
# CodeMie — Local Environment Template
# =============================================================================
# Copy this file to .env and fill in your values:
#
#   cp -n .env.example .env
#
# Use .env.local for personal overrides that should never be committed.
# .env is gitignored; .env.local is gitignored.
# Neither file should ever contain production credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# Local startup defaults
# ---------------------------------------------------------------------------
ENV=development
MODELS_ENV=azure

# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=https://your-azure-openai-endpoint.example.com
OPENAI_API_VERSION=2025-04-01-preview

# ---------------------------------------------------------------------------
# Google Cloud / VertexAI
# ---------------------------------------------------------------------------
GOOGLE_PROJECT_ID=or2-msq-epmd-edp-anthos-t1iylu
GOOGLE_REGION=europe-west3
GOOGLE_VERTEXAI_REGION=us-central1
GOOGLE_CLAUDE_VERTEXAI_REGION=us-east5

# ---------------------------------------------------------------------------
# Speech-to-text
# ---------------------------------------------------------------------------
AZURE_SPEECH_REGION=westus2

# ---------------------------------------------------------------------------
# Source control identifiers
# ---------------------------------------------------------------------------
GITLAB_IDENTIFIERS=["gitlab", "gitbud", "git.epam.com", "git.garage.epam.com"]

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
CODEMIE_PREPUSH_ENABLED=false
LITELLM_PREMIUM_MODELS_ALIASES=["opus"]

# ---------------------------------------------------------------------------
# User Management / Local Auth
# All values below are required for local login to work.
# Use .env.local to override these for your personal setup.
# ---------------------------------------------------------------------------
ENABLE_USER_MANAGEMENT=true
IDP_PROVIDER=local
SUPERADMIN_EMAIL=admin@codemie.ai
SUPERADMIN_PASSWORD=password
EMAIL_VERIFICATION_ENABLED=false
PASSWORD_MIN_LENGTH=1
RATE_LIMIT_LOGIN=200/minute

# ---------------------------------------------------------------------------
# Docker Compose profiles (read by `docker compose`, not by the app)
# ---------------------------------------------------------------------------
# Base services always start: postgres, elasticsearch, mermaid-server, k3s (code executor sandbox).
# Add profiles to start more (comma separated). `app` needs no extra profile for dependencies.
#   app            - codemie
#   litellm        - litellm (also set LLM_PROXY_ENABLED / LLM_PROXY_MODE for codemie to use it)
#   observability  - jaeger, kibana, prometheus, grafana, pyroscope
#   full           - everything
# COMPOSE_PROFILES=app
# COMPOSE_PROFILES=app,litellm
# COMPOSE_PROFILES=app,observability
# COMPOSE_PROFILES=full

# ---------------------------------------------------------------------------
# Code executor sandbox (local k3s from docker compose)
# ---------------------------------------------------------------------------
# codemie in docker compose gets CODE_EXECUTOR_KUBECONFIG_PATH from docker-compose.yml.
# codemie running on the host (poetry/IDE) must point to the k3s kubeconfig:
# CODE_EXECUTOR_KUBECONFIG_PATH=./.kube-local/kubeconfig.yaml
# Sandbox image (public on Docker Hub); override to use a custom one:
# CODE_EXECUTOR_DOCKER_IMAGE=codemie/codemie-python:2.52.0
# The local k3s has no gVisor, and the default runtime class is `gvisor`: sandbox pods would not start. Locally set
# `none` (plain runc inside the privileged k3s container). NEVER outside local development.
# CODE_EXECUTOR_RUNTIME_CLASS_NAME=none
# Namespace of the sandbox pods. The local deny-all NetworkPolicy (docker/k3s/manifests/code-executor.yaml) is bound
# to the default name: if you change it here, change it there too, or the pods run without the policy.
# CODE_EXECUTOR_NAMESPACE=codemie-code-executor
