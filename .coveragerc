[run]
# sys.monitoring core (PEP 669): several times less overhead than the default
# C tracer on Python 3.12. Needs coverage >= 7.9; branch coverage is not used here.
core = sysmon
# Sonar reads coverage only for src/ (sonar.sources=src/codemie); measuring
# tests/ as well doubled the tracked file count and the XML report time.
source =
  src/codemie
  src/codemie_tools
omit =
  */templates/*
  */codemie/clients/provider/*
