+    # the session's start: it is absent from both get_sessions and get_overview's total_sessions. A
+    # window that still covers the session's start is the unresolved residual case — see
+    # test_a_fresh_empty_session_is_still_listed_and_still_not_bucketed_as_dead below.
+    #
+    # This lives alongside the other live-Postgres tests of this file rather than in
+    # test_cli_analytics_handler.py (the plan's literal file choice): that file is a pure mock-based unit
+    # suite with no live-Postgres fixture, and this scenario is only meaningful end-to-end against a real
+    # database the way the rest of this file already seeds one.
+    engine = await _engine()
+    seed = _Seed()
+    name = "vscode-restart-empty"
+    try:
+        await seed.dims(engine, name, seed.now - timedelta(days=10))  # session.start + session.env only, forever
