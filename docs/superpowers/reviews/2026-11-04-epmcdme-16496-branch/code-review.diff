+@pytest.mark.asyncio
+async def test_get_cost_kpis_and_get_users_count_a_costless_session_like_the_sessions_list():
+    # EPMCDME-16496 Task 3: Overview's total_sessions and get_users' session_count/session_ids now count
+    # every session of `sel`, priced or not -- the same universe get_session_cost_facts(include_costless=
+    # True) already lists.
+    engine = await _engine()
+    seed = _Seed()
+    priced, costless = "priced", "costless"
+    try:
+        await seed.dims(engine, priced, seed.now)
