+
+        assert seed.sid(name) not in {s["trace_id"] for s in sessions["sessions"]}
+        assert overview["kpis"]["total_sessions"] == 0
+    finally:
+        await _cleanup(engine, [seed.sid(name)])
+        await engine.close()
+
