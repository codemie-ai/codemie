+@pytest.mark.asyncio
+async def test_a_session_that_started_inside_the_window_with_real_activity_is_still_listed():
+    # Sub-day window-boundary precision for a recently started, genuinely active session
+    # (EPMCDME-15506/15584) is unaffected by the no-activity-ever exclusion above: as soon as a session
+    # has produced one real signal, its unconditional `started_at BETWEEN` admission still applies.
+    engine = await _engine()
