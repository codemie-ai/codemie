+@pytest.mark.asyncio
+async def test_pure_empty_session_is_not_listed_once_the_window_moves_past_its_start():
+    # A session that started inside the window is admitted unconditionally (preserves sub-day window
+    # precision, EPMCDME-15506/15584), so the activity-based exclusion of a truly empty session (gap b)
+    # is observable once a later query's window no longer covers its start time.
+    engine = await _engine()
+    seed = _Seed()
+    name = "empty"
+    try:
+        await seed.dims(engine, name, seed.now - timedelta(days=10))  # only session.start/env, ever
+        reader = PostgresCliAnalyticsReader(engine)
+
+        assert await _is_listed(reader, seed.window(), seed.sid(name)) is False
+    finally:
+        await _cleanup(engine, [seed.sid(name)])
+        await engine.close()
+
