+    project_name: str = Path(alias="projectName"),
+    user: User = Depends(authenticate),
+):
+    """Update the allowed_models field for a project.
+
+    Only project admins and maintainers can update this field.
+    Returns 400 if allowed_models is empty or contains no chat models.
+    Returns 403 if user lacks admin/maintainer role.
+    Returns 404 if project doesn't exist.
+    """
+    _ensure_user_management_enabled()
+
+    with get_session() as session:
+        validated_models = project_service.validate_allowed_models(payload.allowed_models)
+        project_service.validate_at_least_one_chat_model_allowed(validated_models)
+        project_service.check_allowed_models_authorization(session, user, project_name)
+
+        # Validate default_model if provided
+        if payload.default_model:
+            project_service.validate_default_model(payload.default_model, validated_models)
+
+        project = application_repository.get_by_name_case_insensitive(session, project_name)
+        if not project:
+            raise ExtendedHTTPException(status_code=404, detail=f"Project {project_name} not found")
+
+        project = session.execute(
+            select(Application).where(Application.id == project.id).with_for_update()
+        ).scalar_one_or_none()
+
+        if not project:
+            raise ExtendedHTTPException(status_code=404, detail=f"Project {project_name} not found")
+
+        project.allowed_models = validated_models
+        if payload.default_model is not None:
+            project.default_model = payload.default_model
+        session.add(project)
+        try:
+            session.commit()
+            session.refresh(project)
+        except Exception:
+            logger.exception("Failed to update allowed_models for project %s", project_name)
+            session.rollback()
+            raise ExtendedHTTPException(status_code=500, detail="Failed to update project allowed models")
+
+        return AllowedModelsUpdateResponse(
+            name=project.name,
+            display_name=project.display_name,
+            description=project.description or "",
+            project_type=project.project_type,
+            created_by=project.created_by or user.id,
