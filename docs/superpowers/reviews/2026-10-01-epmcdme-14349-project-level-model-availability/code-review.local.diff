+```python
+@router.patch("/{projectName}/allowed-models")
+async def patch_allowed_models(
+    projectName: str,
+    request: AllowedModelsUpdateRequest,
+    session: AsyncSession = Depends(get_session),
+    member: Member = Depends(get_current_member),
+) -> AllowedModelsUpdateResponse:
+    """Update allowed_models for a project and regenerate virtual keys."""
+    # Validate
+    validated_models = ProjectService.validate_allowed_models(request.allowed_models)
+    
+    # Authorize
+    project = await ProjectRepository.get_by_name(session, projectName)
+    if not project:
+        raise HTTPException(status_code=404, detail="Project not found")
+    
+    if member.role not in [Role.ADMIN, Role.MAINTAINER]:
+        raise HTTPException(status_code=403, detail="Only admins and maintainers can update allowed_models")
+    
+    # Save to database
+    project.allowed_models = validated_models
+    session.add(project)
+    await session.commit()
+    
+    # Regenerate virtual keys with updated allowed_models
+    await project_budget_service.ensure_project_budget(
+        project_name=project.name,
+        models=project.allowed_models,
+    )
+    
+    return AllowedModelsUpdateResponse(
+        project_name=project.name,
+        allowed_models=project.allowed_models,
+    )
+```
