+
+import contextlib
+import os
+
+import pytest
+from hypothesis import settings
+
+# Force ENV=local before importing the app so the user-id header bypass
+# is active in PersistentUserProvider.
+os.environ.setdefault("ENV", "local")
+
+import schemathesis  # noqa: E402
+from schemathesis.checks import not_a_server_error  # noqa: E402
+from schemathesis.specs.openapi.checks import (  # noqa: E402
+    content_type_conformance,
+    response_schema_conformance,
+)
+
+from codemie.rest_api.main import app  # noqa: E402  (env must be set first)
+
+
+@contextlib.asynccontextmanager
+async def _noop_lifespan(_app):
+    yield
+
+
+# Stub the lifespan so from_asgi does not trigger IDP / LiteLLM / Redis
+# startup. Applied at import time so schemathesis' from_asgi picks it up.
+app.router.lifespan_context = _noop_lifespan
+
+
+SCHEMA = (
+    schemathesis.openapi.from_asgi("/openapi.json", app)
+    .include(path_regex=r"/v\d+/assistants")
+    .exclude(path_regex=r"(?i)(chat|agent|evaluate|ask|enterprise)")
+)
+
+
+@pytest.fixture(scope="session")
+def superadmin_user_id() -> str:
+    return os.environ.get(
