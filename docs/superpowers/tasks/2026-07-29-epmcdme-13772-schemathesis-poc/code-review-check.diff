 """Schemathesis PoC — contract/fuzz coverage for the `assistants` router.
 
-See docs/superpowers/tasks/2026-07-29-epmcdme-13772-schemathesis-poc/spec.md
-for the design decisions behind the lifespan stub, path filter, and
-`user-id` header auth bypass.
+Isolation rules for this module (see code-review-final.json findings):
+
+* Runs read-only (GET) endpoints only. Write endpoints require DB
+  transactional isolation not yet in place (CR-003 — follow-up).
+* Excludes LLM/agent/enterprise/MCP endpoint families via path regex
+  (CR-001, CR-002).
+* Restores the app lifespan on session teardown so other router tests
+  are not contaminated (CR-006).
+* Guarded by `pytest.importorskip("schemathesis")` because the dep is
+  not yet in pyproject.toml/poetry.lock (CR-004 — known follow-up).
+* Marked with `pytest.mark.schemathesis` so the module can be filtered
+  in/out of `pytest tests/` runs (register the marker in pytest.ini).
+
+Run this module in isolation:
+
+    pytest tests/codemie/rest_api/routers/test_schemathesis_assistants.py \
+        --junitxml=tests/reports/schemathesis-junit.xml
+
+See docs/superpowers/tasks/2026-07-29-epmcdme-13772-schemathesis-poc/
+for spec.md, plan.md, findings.md, and the code-review verdict.
 """
 
 import contextlib
 import os
 
 import pytest
-from hypothesis import settings
 
-# Force ENV=local before importing the app so the user-id header bypass
-# is active in PersistentUserProvider.
-os.environ.setdefault("ENV", "local")
+# CR-004: dep is not in pyproject.toml/lock yet — degrade gracefully on
+# fresh checkouts / CI runners that have not installed schemathesis in
+# the poetry venv. Fail-fast with a clear reason rather than an
+# ImportError at collection time.
+schemathesis = pytest.importorskip("schemathesis")
+from hypothesis import settings  # noqa: E402
+
+# CR-005: pytest.ini sets ENV=local via pytest-env before this module
+# imports, so PersistentUserProvider will honour the user-id header
+# bypass. Assert it here so a non-pytest invocation (e.g. a direct
+# python -c import) fails immediately with a clear reason rather than
+# producing 42 silent 401s.
+assert os.environ.get("ENV") == "local", (
+    "test_schemathesis_assistants requires ENV=local so the user-id "
+    "header auth bypass in PersistentUserProvider is active. Run this "
+    "via pytest (pytest.ini sets ENV=local) or export ENV=local "
+    "manually."
+)
 
-import schemathesis  # noqa: E402
 from schemathesis.checks import not_a_server_error  # noqa: E402
 from schemathesis.specs.openapi.checks import (  # noqa: E402
     content_type_conformance,
@@ -39,20 +69,56 @@ from schemathesis.specs.openapi.checks import (  # noqa: E402
 from codemie.rest_api.main import app  # noqa: E402  (env must be set first)
 
 
+# CR-006: capture the original lifespan so it can be restored on
+# session teardown; do not leak the noop lifespan into other tests
+# that reuse the same app object in the same pytest session.
+_ORIGINAL_LIFESPAN = app.router.lifespan_context
+
+
 @contextlib.asynccontextmanager
 async def _noop_lifespan(_app):
     yield
 
 
-# Stub the lifespan so from_asgi does not trigger IDP / LiteLLM / Redis
-# startup. Applied at import time so schemathesis' from_asgi picks it up.
 app.router.lifespan_context = _noop_lifespan
 
 
+# CR-006 (continued): restore the original lifespan when this module's
+# tests are done.
+@pytest.fixture(scope="module", autouse=True)
+def _restore_lifespan():
+    yield
+    app.router.lifespan_context = _ORIGINAL_LIFESPAN
+
+
+# Marker so this module can be selected/deselected explicitly.
+pytestmark = pytest.mark.schemathesis
+
+
+# CR-001, CR-002: exclude LLM/agent/enterprise families AND every write
+# path that could leak side effects (create/update/delete/publish,
+# model inference, external MCP calls). Segment-anchored where
+# possible; case-insensitive.
+_EXCLUDE_REGEX = (
+    r"(?i)"
+    r"("
+    r"/chat|/agent|/evaluate|/ask|/enterprise"  # LLM/agent surfaces
+    r"|/generate|/refine|/prompt/generate"  # LLM generation
+    r"|/model(/|$)"  # model inference
+    r"|/mcp(/|_)"  # external MCP calls
+    r")"
+)
+
+# CR-003: restrict to read-only methods for this PoC. Write endpoints
+# would need transactional DB isolation, which is out of PoC scope.
+# Documented as follow-up in findings.md.
+_ALLOWED_METHODS_REGEX = r"^(GET|HEAD|OPTIONS)$"
+
+
 SCHEMA = (
     schemathesis.openapi.from_asgi("/openapi.json", app)
-    .include(path_regex=r"/v\d+/assistants")
-    .exclude(path_regex=r"(?i)(chat|agent|evaluate|ask|enterprise)")
+    .include(path_regex=r"/v\d+/assistants", method_regex=_ALLOWED_METHODS_REGEX)
+    .exclude(path_regex=_EXCLUDE_REGEX)
 )
 
 
