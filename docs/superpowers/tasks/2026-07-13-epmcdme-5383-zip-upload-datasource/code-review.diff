+    @staticmethod
+    def _expand_zip_file(zip_bytes: bytes) -> list[tuple[str, bytes]]:
+        result: list[tuple[str, bytes]] = []
+        seen_names: set[str] = set()
+        total_size = 0
+
+        try:
+            zf_ctx = zipfile.ZipFile(io.BytesIO(zip_bytes))
+        except zipfile.BadZipFile as exc:
+            raise ExtendedHTTPException(
+                code=status.HTTP_422_UNPROCESSABLE_ENTITY,
+                message="Invalid ZIP archive",
+                details="The uploaded file could not be opened as a ZIP archive.",
+                help="Ensure the file is a valid ZIP archive and try again.",
+            ) from exc
+
+        with zf_ctx as zf:
+            for info in zf.infolist():
+                if info.is_dir():
+                    continue
+                total_size += info.file_size
+                if total_size > _ZIP_MAX_UNCOMPRESSED_BYTES:
+                    raise ExtendedHTTPException(
+                        code=status.HTTP_422_UNPROCESSABLE_ENTITY,
+                        message="ZIP archive too large",
+                        details=f"Uncompressed content exceeds the {_ZIP_MAX_UNCOMPRESSED_BYTES // (1024 * 1024)} MB limit.",
+                        help="Upload a smaller archive or split the content into multiple files.",
+                    )
+                # Normalise Windows backslash separators before basename extraction
+                normalised = info.filename.replace("\\", "/")
+                flat_name = os.path.basename(normalised)
+                if not flat_name:
+                    continue
+                if flat_name.startswith("._"):  # Apple Double resource forks — metadata, not content
+                    continue
+                ext = os.path.splitext(flat_name)[1].lstrip(".").lower()
+                if ext == IndexKnowledgeBaseFileTypes.ZIP.value:
+                    logger.warning(f"Skipping nested ZIP in archive: {info.filename}")
+                    continue
+                if flat_name in seen_names:
+                    logger.warning(f"Skipping duplicate filename in ZIP: {info.filename}")
+                    continue
+                seen_names.add(flat_name)
+                result.append((flat_name, zf.read(info.filename)))
+
+        return result
+
