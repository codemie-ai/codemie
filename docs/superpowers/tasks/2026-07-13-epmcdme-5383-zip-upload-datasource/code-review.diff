+def _make_zip_bytes(*members: tuple[str, bytes]) -> bytes:
+    """Return in-memory ZIP bytes containing the given (name, content) pairs."""
+    buf = io.BytesIO()
+    with zipfile.ZipFile(buf, "w") as zf:
+        for name, content in members:
+            zf.writestr(name, content)
+    return buf.getvalue()
+
