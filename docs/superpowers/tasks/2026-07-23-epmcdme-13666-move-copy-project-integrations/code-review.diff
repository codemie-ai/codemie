+class TestPartition:
+    def test_copy_skips_trigger_types(self):
+        # Arrange
+        jira = _setting("jira-prod", CredentialTypes.JIRA)
+        hook = _setting("gitlab-hook", CredentialTypes.WEBHOOK)
