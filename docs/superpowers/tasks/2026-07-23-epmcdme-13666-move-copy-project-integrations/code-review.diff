+def _setting(alias, credential_type=CredentialTypes.JIRA, setting_type=SettingType.PROJECT, user_id="u1", id_=None):
+    return Settings(
+        id=id_ or f"id-{alias}",
+        project_name="source",
+        alias=alias,
+        credential_type=credential_type,
