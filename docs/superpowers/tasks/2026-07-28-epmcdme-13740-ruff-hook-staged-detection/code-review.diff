+# limitations under the License.
+
+# Ruff format/fix check against staged Python content only.
+#
+# Reads the staged blob of each .py file, pipes it through ruff format and
+# ruff check --fix on stdin, and compares the result to the original staged
+# content. The working tree is not touched, so unstaged edits (including the
+# git add -p scenario) cannot cause false positives.
+#
+# Exit 0 = no staged .py OR every staged .py is already formatted/clean.
+# Exit 1 = ruff would change at least one staged .py; user must run
+#          `ruff format <files>` (or `make ruff`) and re-stage before commit.
+#
+# Invoked as a subprocess from scripts/git-hooks/pre_commit.sh. RUFF_CMD env
+# overrides the ruff invocation prefix (default "poetry run ruff") for testing.
+
+set -euo pipefail
+
+RUFF_CMD="${RUFF_CMD:-poetry run ruff}"
+
+staged_py_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
+
+if [[ -z "$staged_py_files" ]]; then
+  echo "[pre-commit] No staged Python files - skipping Ruff format/fix check."
+  exit 0
+fi
+
+echo "[pre-commit] Checking staged Python content against Ruff..."
+
+changed_files=""
+while IFS= read -r f; do
+  [[ -z "$f" ]] && continue
+  orig=$(git show ":$f")
+  # ruff format on stdin
+  formatted=$(printf '%s' "$orig" \
+    | $RUFF_CMD format --force-exclude --stdin-filename "$f" -)
+  # ruff check --fix on the formatted output (silence check exit — lint
+  # violations that ruff cannot autofix are surfaced later by the read-only
+  # `ruff check` step of pre_commit.sh, not here)
+  fixed=$(printf '%s' "$formatted" \
+    | $RUFF_CMD check --fix --force-exclude --stdin-filename "$f" - 2>/dev/null || true)
+  if [[ "$orig" != "$fixed" ]]; then
+    changed_files+="$f"$'\n'
+  fi
+done <<< "$staged_py_files"
+
+if [[ -n "$changed_files" ]]; then
+  echo "[pre-commit] Ruff would change the following staged files:"
+  printf '%s' "$changed_files"
+  echo "[pre-commit] Please run 'poetry run ruff format <files>' (or 'make ruff'), git add the fixes, and commit again."
+  echo "[pre-commit] Skipping tests now to avoid running them twice."
+  exit 1
+fi
+
+exit 0
