     object_attributes.update(attr_overrides)
     return {
         "object_kind": "merge_request",
-        "action": action,
         "event_type": "merge_request",
         "user": {"id": 1, "name": "John Doe", "username": "johndoe"},
+        "labels": [],
+        "changes": {},
         "project": {
             "id": 12345,
             "name": "test-project",
