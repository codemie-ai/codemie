+  class WorkflowGeneratorService:
+      @classmethod
+      def refine_workflow(
+          cls,
+          yaml_config: str,
+          refine_prompt: Optional[str],
+          user: User,
+          llm_model: Optional[str],
+          request_id: Optional[str],
+      ) -> WorkflowRefineResponse:
