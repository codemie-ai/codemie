# Copy this file to .env.standalone and fill in real values.
# Referenced by docker-compose.standalone.yml via `env_file: - .env.standalone`.

# --- Core platform ---
# Do not use ENV=local: it accepts a user-id header as login and makes every user an admin.
ENV=development
FRONTEND_URL=http://localhost:8080
# The backend default is 5/15minutes; this is higher for CI/CD tooling and parallel test workers.
RATE_LIMIT_LOGIN=100/15minutes
ADMIN_LOG_LOOKUP_ENABLED=false
ENABLE_USER_MANAGEMENT=true

# --- LLM provider selection ---
# MODELS_ENV picks codemie/config/llms/llm-{MODELS_ENV}-config.yaml.
# Use exactly one of the two blocks below (Azure OpenAI or AWS Bedrock).
# Any non-empty provider value counts as configured, so placeholders like <your-azure-openai-key>
# must be replaced with real values or removed.

# Azure OpenAI
MODELS_ENV=azure
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_URL=<https://your-resource.openai.azure.com>
OPENAI_API_VERSION=2025-04-01-preview

# AWS Bedrock (comment out the Azure block above and uncomment this one instead)
# MODELS_ENV=aws
# AWS_BEDROCK_REGION=us-east-1
# AWS_ACCESS_KEY_ID=<access-key>
# AWS_SECRET_ACCESS_KEY=<secret-key>

# Local Auth
SUPERADMIN_EMAIL=admin@codemie.ai
SUPERADMIN_PASSWORD=change-me-password

# --- CLI Analytics ---
# Enabled through features:cliAnalytics in the customer configuration, not by a variable here.
# It stores data in the same PostgreSQL as the application (PG_URL, set in
# docker-compose.standalone.yml); no extra variables are needed. See standalone/README.md.

# --- Redis-dependent features (optional) ---
# The default Compose stack has no Redis service. Leave the Redis host variable unset (or empty)
# to run without one: Google integration OAuth stays disabled and webhook rate limiting is skipped
# (webhooks are still accepted, just unlimited) — both log a one-time startup warning, nothing
# fails. Point it at a reachable Redis to turn either feature on; see "Redis-dependent features"
# in standalone/README.md for the exact variable name and a concrete example.
# Requires the Redis host variable above to be set; otherwise Google OAuth stays disabled regardless of this flag.
# GOOGLE_OAUTH_ENABLED=true
# Defaults to true; only takes effect when the Redis host variable is set (see the comment above).
# WEBHOOK_RATE_LIMIT_ENABLED=true
