ENABLE_USER_MANAGEMENT=false
IDP_PROVIDER=keycloak
ENABLE_FILE_MULTIPROCESSING=false
AZURE_OPENAI_API_KEY=test-azure-openai-key
AZURE_OPENAI_URL=https://test.openai.azure.com/
PASSWORD_MIN_LENGTH=1
LITELLM_PREMIUM_MODELS_ALIASES=["opus"]
# Pin feature switches to the defaults the tests assume, so a developer's local .env or shell cannot change results.
LLM_PROXY_ENABLED=false
FILE_SYSTEM_TOOLS_ENABLED=false
CODE_EXECUTOR_ENABLED=false
